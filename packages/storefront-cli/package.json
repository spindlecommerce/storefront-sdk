{
  "name": "@spindlecommerce/storefront-cli",
  "version": "0.1.0",
  "description": "Deploy a SpindleCommerce storefront's page-builder components from its code, and generate TypeScript types for their content.",
  "keywords": [
    "spindlecommerce",
    "storefront"
  ],
  "homepage": "https://github.com/spindlecommerce/storefront-sdk/tree/main/packages/storefront-cli#readme",
  "bugs": "https://github.com/spindlecommerce/storefront-sdk/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/spindlecommerce/storefront-sdk.git",
    "directory": "packages/storefront-cli"
  },
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "bin": {
    "spindle-storefront": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "26.6.5"
  }
}
